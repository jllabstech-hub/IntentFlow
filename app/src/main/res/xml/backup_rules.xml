<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for IntentFlow.
  User intent history and preferences are device-local.
  No user data is exported to cloud backup by default (privacy-first).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
